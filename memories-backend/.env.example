# Server
NODE_ENV=development
PORT=3000
# Comma-separated list. Leave empty in local development to allow the Angular dev server.
# Add the Cloudflare Pages URL here when it exists, for example
# https://our-memories.pages.dev
CORS_ORIGINS=http://localhost:4200

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Cloudflare R2
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_BUCKET_NAME=<bucket-name>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
# Optional: set this when media is served through an R2 custom domain.
R2_PUBLIC_BASE_URL=https://media.example.com
